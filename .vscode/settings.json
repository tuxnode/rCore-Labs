{
    // Prevent "can't find crate for `test`" error on no_std
    // Ref: https://github.com/rust-lang/vscode-rust/issues/729
    // For Rust Analyzer plugin users:
    // NOTE: the cross-compilation target is set per-crate in each crate's
    // .cargo/config.toml (os/, user/). Setting a global rust-analyzer.cargo.target
    // here would also force the host-side easy-fs-fuse crate to be checked against
    // riscv64gc-unknown-none-elf, where std does not exist, producing spurious
    // "cannot find Sized/Result/write!..." errors in its dependencies (ansi_term).
    "rust-analyzer.check.allTargets": false,
    "rust-analyzer.checkOnSave": true,
    "rust-analyzer.cargo.buildScripts.enable": true
    // "rust-analyzer.cargo.features": [
    //     "board_qemu"
    // ]
}